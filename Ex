import numpy as np
import pandas as pd
text = "NLP makes it easy to analyze text using NLP tools"
words = list(set(text.split()))
matrix = pd.DataFrame(0, index=words, columns=words)
tokens = text.split()
for i, w in enumerate(tokens):
    for j in range(len(tokens)):
        if i != j:
            matrix.loc[w, tokens[j]] += 1
print(matrix)


